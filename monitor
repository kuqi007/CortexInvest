#!/bin/bash
# 监控服务启动器 - 使用虚拟环境
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
VENV_DIR="$DIR/.venv"
VENV_PYTHON="$VENV_DIR/bin/python3"

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${BLUE}=== AI 投资系统 - 监控服务启动器 ===${NC}"

# 检查虚拟环境
if [ ! -d "$VENV_DIR" ]; then
    echo -e "${YELLOW}错误: 虚拟环境不存在${NC}"
    echo "请先运行: ./setup_monitor.sh"
    exit 1
fi

# 检查必要文件
if [ ! -f "$DIR/.env" ]; then
    echo -e "${YELLOW}警告: .env 文件不存在，已创建模板${NC}"
    cp "$DIR/.env.example" "$DIR/.env"
    echo "请编辑 .env 文件填入你的 API 密钥"
fi

# 激活虚拟环境并运行启动脚本
export PATH="$VENV_DIR/bin:$PATH"
export VIRTUAL_ENV="$VENV_DIR"

# 创建符号链接，让 start_monitor.sh 能找到正确的 python
cd "$DIR"
echo -e "${GREEN}✓ 使用虚拟环境: $VENV_DIR${NC}"

# 执行原脚本
exec "$DIR/start_ai_investor_full.sh" "$@"
