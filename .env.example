# Kimi API 配置 (推荐，OpenAI 兼容协议)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Gemini API 配置 (备选)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Compatible API 配置 (通用备选)
OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_MODEL=your_model_name

# MX Search (东方财富妙想搜索，替代 Google 搜索)
MX_APIKEY=

# Local DB paths (每台机器各自配置)
# 不依赖符号链接时设置 AI_INVESTOR_DATA_DIR，Python daemon 和 web 都读它
# 以及文件级别的 AI_INVESTOR_CONFIG_DB_PATH / AI_INVESTOR_TRADING_DB_PATH
# Linux/macOS: /Users/<username>/Library/CloudStorage/OneDrive-<org>/
# Windows: C:\Users\<username>\OneDrive\<org>\
# AI_INVESTOR_DATA_DIR=/path/to/ai-investor-data
# AI_INVESTOR_CONFIG_DB_PATH=${AI_INVESTOR_DATA_DIR}/config.db
# AI_INVESTOR_TRADING_DB_PATH=${AI_INVESTOR_DATA_DIR}/trading.db

# Feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_OPEN_ID=

